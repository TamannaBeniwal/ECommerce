<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create an Account | E-Shop</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Font Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
        }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 antialiased min-h-screen flex flex-col justify-center py-12 px-4 sm:px-6 lg:px-8">

    <div class="sm:mx-auto sm:w-full sm:max-w-md">
        <!-- Brand Logo & Header -->
        <div class="text-center">
            <a href="/" class="inline-flex items-center gap-2 text-2xl font-black tracking-tight text-slate-900 group">
                <span class="w-10 h-10 rounded-xl bg-indigo-600 text-white flex items-center justify-center shadow-lg shadow-indigo-200 group-hover:scale-105 transition-transform">🛍️</span>
                <span>E<span class="text-indigo-600">-Shop</span></span>
            </a>
            <h2 class="mt-5 text-2xl font-extrabold text-slate-900 tracking-tight">
                Create an account
            </h2>
            <p class="mt-1 text-xs text-slate-500">
                Join our smart commerce platform to start shopping and managing products.
            </p>
        </div>

        <!-- Register Card -->
        <div class="mt-8 bg-white py-8 px-6 shadow-sm border border-slate-200 rounded-3xl sm:px-10">
            <form action="/users/register" method="POST" class="space-y-5">
                
                <!-- Username Field -->
                <div>
                    <label for="username" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">
                        Username
                    </label>
                    <input 
                        type="text" 
                        id="username"
                        name="username" 
                        required 
                        placeholder="e.g. tamanna"
                        class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:bg-white focus:border-indigo-500 focus:ring-4 focus:ring-indigo-100 outline-none transition-all"
                    >
                </div>

                <!-- Email Field -->
                <div>
                    <label for="email" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">
                        Email Address
                    </label>
                    <input 
                        type="email" 
                        id="email"
                        name="email" 
                        required 
                        placeholder="you@example.com"
                        class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:bg-white focus:border-indigo-500 focus:ring-4 focus:ring-indigo-100 outline-none transition-all"
                    >
                </div>

                <!-- Password Field -->
                <div>
                    <label for="password" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">
                        Password
                    </label>
                    <input 
                        type="password" 
                        id="password"
                        name="password" 
                        required 
                        placeholder="••••••••"
                        class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:bg-white focus:border-indigo-500 focus:ring-4 focus:ring-indigo-100 outline-none transition-all"
                    >
                </div>

                <!-- Submit Button -->
                <div class="pt-2">
                    <button 
                        type="submit" 
                        class="w-full py-3 px-4 text-sm font-semibold text-white bg-indigo-600 hover:bg-indigo-700 active:scale-[0.99] rounded-xl shadow-md shadow-indigo-100 transition-all">
                        Create Account
                    </button>
                </div>

            </form>

            <!-- Login Footer -->
            <div class="mt-6 pt-6 border-t border-slate-100 text-center">
                <p class="text-xs text-slate-500">
                    Already have an account? 
                    <a href="/users/login" class="font-bold text-indigo-600 hover:text-indigo-700 hover:underline transition">
                        Log in here
                    </a>
                </p>
            </div>
        </div>

        <!-- Back to Store Link -->
        <div class="mt-6 text-center">
            <a href="/" class="text-xs font-semibold text-slate-400 hover:text-slate-700 transition">
                ← Back to Store
            </a>
        </div>
    </div>

</body>
</html>