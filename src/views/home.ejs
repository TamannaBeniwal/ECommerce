<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>E-Shop | Smart Commerce</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Font Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
        }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 antialiased min-h-screen">

<!-- 🔹 Sticky Modern Navbar -->
<header class="sticky top-0 z-50 bg-white/80 backdrop-blur-md border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between gap-4">
        
        <!-- Logo -->
        <a href="/" class="flex items-center gap-2 text-2xl font-black tracking-tight text-slate-900 group">
            <span class="w-10 h-10 rounded-xl bg-indigo-600 text-white flex items-center justify-center shadow-lg shadow-indigo-200 group-hover:scale-105 transition-transform">🛍️</span>
            <span>E<span class="text-indigo-600">-Shop</span></span>
        </a>

        <!-- AI Smart Search Bar -->
        <form action="/products/search" method="GET" class="flex-1 max-w-xl mx-2">
            <div class="relative flex items-center">
                <input 
                    type="text" 
                    name="q" 
                    value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>"
                    placeholder="Ask AI: e.g. 'refreshing tea under 200' or 'beauty items'..." 
                    class="w-full pl-11 pr-24 py-2.5 bg-slate-100 hover:bg-slate-50 focus:bg-white text-sm rounded-full border border-transparent focus:border-indigo-500 focus:ring-4 focus:ring-indigo-100 outline-none transition-all duration-200"
                />
                <span class="absolute left-4 text-slate-400 text-sm">✨</span>
                <button 
                    type="submit" 
                    class="absolute right-1.5 px-4 py-1.5 text-xs font-semibold text-white bg-indigo-600 hover:bg-indigo-700 active:scale-95 rounded-full shadow-sm transition-all duration-150">
                    Search
                </button>
            </div>
        </form>

        <!-- User Controls / Auth -->
        <div class="flex items-center gap-3">
            <% if(decode){ %>
                <div class="hidden sm:flex flex-col text-right">
                    <span class="text-xs text-slate-400 font-medium">Logged in</span>
                    <span class="text-xs font-bold text-slate-700 max-w-[100px] truncate"><%= decode.username %></span>
                </div>

                <a href="/cart" class="relative inline-flex items-center gap-2 px-3.5 py-2 text-xs font-semibold text-slate-700 bg-slate-100 hover:bg-slate-200 rounded-xl transition-all">
                    <span>🛒</span>
                    <span>Cart</span>
                    <span class="bg-indigo-600 text-white text-[10px] font-bold px-1.5 py-0.5 rounded-full"><%= cartCount %></span>
                </a>

                <a href="/users/logout" class="px-3.5 py-2 text-xs font-medium text-rose-600 hover:bg-rose-50 rounded-xl transition-all">
                    Logout
                </a>
            <% } else { %>
                <a href="/users/login" class="px-5 py-2 text-xs font-semibold text-white bg-slate-900 hover:bg-slate-800 rounded-xl shadow-sm transition-all">
                    Login
                </a>
            <% } %>
        </div>
    </div>
</header>

<main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">

    <!-- 🔹 Categories Filter Pills -->
    <div class="flex items-center gap-2 overflow-x-auto pb-4 scrollbar-none">
        <a href="/" class="px-4 py-2 text-xs font-semibold rounded-full bg-slate-900 text-white shadow-sm hover:bg-slate-800 transition">All Items</a>
        <a href="/?category=Beauty" class="px-4 py-2 text-xs font-medium rounded-full bg-white text-slate-600 border border-slate-200 hover:border-indigo-400 hover:text-indigo-600 transition">💄 Beauty</a>
        <a href="/?category=Groceries" class="px-4 py-2 text-xs font-medium rounded-full bg-white text-slate-600 border border-slate-200 hover:border-indigo-400 hover:text-indigo-600 transition">🥦 Groceries</a>
        <a href="/?category=Electronics" class="px-4 py-2 text-xs font-medium rounded-full bg-white text-slate-600 border border-slate-200 hover:border-indigo-400 hover:text-indigo-600 transition">⚡ Electronics</a>
        <a href="/?category=Clothing" class="px-4 py-2 text-xs font-medium rounded-full bg-white text-slate-600 border border-slate-200 hover:border-indigo-400 hover:text-indigo-600 transition">👕 Clothing</a>
        <a href="/?category=Footwear" class="px-4 py-2 text-xs font-medium rounded-full bg-white text-slate-600 border border-slate-200 hover:border-indigo-400 hover:text-indigo-600 transition">👟 Footwear</a>
        <a href="/?category=HomeDecor" class="px-4 py-2 text-xs font-medium rounded-full bg-white text-slate-600 border border-slate-200 hover:border-indigo-400 hover:text-indigo-600 transition">🏠 HomeDecor</a>
        <a href="/?category=KidsSection" class="px-4 py-2 text-xs font-medium rounded-full bg-white text-slate-600 border border-slate-200 hover:border-indigo-400 hover:text-indigo-600 transition">👶 KidsSection</a>

        
    </div>

    <!-- 🔹 Action Bar (Add Product + Sort Dropdown) -->
    <div class="flex items-center justify-between my-6 border-b border-slate-200 pb-4">
        <div class="flex items-center gap-2">
            <h1 class="text-lg font-bold text-slate-800">Products Catalog</h1>
            <span class="text-xs font-medium px-2.5 py-0.5 rounded-md bg-slate-200 text-slate-700"><%= products.length %> items</span>
        </div>

        <div class="flex items-center gap-3">
            <form method="GET" action="/">
                <select name="sort" onchange="this.form.submit()" class="text-xs font-medium bg-white border border-slate-200 rounded-xl px-3 py-2 outline-none focus:border-indigo-500 cursor-pointer">
                    <option value="">Sort By</option>
                    <option value="low">Price: Low to High</option>
                    <option value="high">Price: High to Low</option>
                </select>
            </form>

            <a href="/products/add" class="inline-flex items-center gap-1.5 px-4 py-2 text-xs font-semibold text-white bg-emerald-600 hover:bg-emerald-700 rounded-xl shadow-sm hover:shadow transition-all">
                <span>+</span> Add Product
            </a>
        </div>
    </div>

    <!-- 🔹 Product Cards Grid -->
    <% if(products.length === 0){ %>
        <div class="text-center py-20 bg-white rounded-3xl border border-dashed border-slate-200 my-8">
            <div class="text-5xl mb-3">🔍</div>
            <h3 class="text-base font-semibold text-slate-800">No products found</h3>
            <p class="text-xs text-slate-500 mt-1 max-w-sm mx-auto">Try searching for something else or explore our categories above.</p>
            <a href="/" class="mt-4 inline-block px-4 py-2 text-xs font-semibold text-indigo-600 bg-indigo-50 rounded-xl hover:bg-indigo-100 transition">Reset Search</a>
        </div>
    <% } else { %>
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-5">
            <% products.forEach(product => { %>
                <div class="group bg-white rounded-2xl border border-slate-200 overflow-hidden hover:shadow-lg hover:-translate-y-1 transition-all duration-200 flex flex-col justify-between">
                    
                    <div>
                        <!-- Product Image -->
                        <div class="w-full aspect-square bg-slate-100 overflow-hidden relative">
                            <img src="<%= product.image %>" alt="<%= product.title %>" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300">
                            <span class="absolute top-2.5 left-2.5 text-[10px] font-bold tracking-wide uppercase px-2 py-1 rounded-md bg-white/90 backdrop-blur-sm text-slate-700 shadow-sm">
                                <%= product.category %>
                            </span>
                        </div>

                        <!-- Product Content -->
                        <div class="p-4">
                            <h3 class="font-bold text-slate-900 text-sm truncate group-hover:text-indigo-600 transition-colors" title="<%= product.title %>">
                                <%= product.title %>
                            </h3>
                            <p class="text-slate-900 font-extrabold text-base mt-1.5">
                                ₹ <%= product.price %>
                            </p>
                        </div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="p-4 pt-0 grid grid-cols-2 gap-2">
                        <a href="/products/detail/<%= product._id %>" class="text-center py-2 text-xs font-semibold text-slate-700 bg-slate-100 hover:bg-slate-200 rounded-xl transition">
                            👁️ View
                        </a>
                        <a href="/cart/add/<%= product._id %>" class="text-center py-2 text-xs font-semibold text-white bg-indigo-600 hover:bg-indigo-700 rounded-xl shadow-sm transition">
                            🛒 Add
                        </a>
                    </div>
                </div>
            <% }) %>
        </div>
    <% } %>

</main>

</body>
</html>