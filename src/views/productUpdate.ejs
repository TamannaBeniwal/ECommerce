<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit <%= product.title %> | E-Shop</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Font Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
        }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 antialiased min-h-screen py-10 px-4 sm:px-6 lg:px-8">

    <div class="max-w-xl mx-auto">
        <!-- Back Navigation -->
        <div class="mb-6 flex items-center justify-between">
            <a href="/products/detail/<%= product._id %>" class="inline-flex items-center gap-2 text-xs font-semibold text-slate-500 hover:text-slate-900 transition">
                <span>←</span> Cancel & Back
            </a>
            <span class="text-xs text-slate-400 font-medium">ID: <%= product._id %></span>
        </div>

        <!-- Form Card Container -->
        <div class="bg-white rounded-3xl border border-slate-200 p-8 sm:p-10 shadow-sm">
            <div class="mb-8">
                <span class="text-xs font-bold uppercase tracking-wider text-amber-600 bg-amber-50 px-3 py-1 rounded-full">
                    Product Editor
                </span>
                <h1 class="text-2xl font-extrabold text-slate-900 tracking-tight mt-3">
                    Update Product
                </h1>
                <p class="text-xs text-slate-500 mt-1">
                    Modify product details, category classification, or pricing.
                </p>
            </div>

            <form action="/products/update/<%= product._id %>" enctype="multipart/form-data" method="POST" class="space-y-5">
                
                <!-- Title -->
                <div>
                    <label for="title" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">
                        Product Title
                    </label>
                    <input 
                        type="text" 
                        id="title"
                        name="title" 
                        required
                        value="<%= product.title %>"
                        placeholder="e.g. Organic Matcha Green Tea" 
                        class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:bg-white focus:border-indigo-500 focus:ring-4 focus:ring-indigo-100 outline-none transition-all"
                    >
                </div>

                <!-- Description -->
                <div>
                    <label for="description" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">
                        Description
                    </label>
                    <textarea 
                        id="description"
                        name="description" 
                        rows="3"
                        placeholder="Provide details about quality, ingredients, or specifications..." 
                        class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:bg-white focus:border-indigo-500 focus:ring-4 focus:ring-indigo-100 outline-none transition-all resize-none"
                    ><%= product.description %></textarea>
                </div>

                <!-- Category & Price in 2 Columns -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label for="category" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">
                            Category
                        </label>
                        <input 
                            type="text" 
                            id="category"
                            name="category" 
                            required
                            list="category-suggestions"
                            value="<%= product.category %>"
                            placeholder="e.g. Groceries" 
                            class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:bg-white focus:border-indigo-500 focus:ring-4 focus:ring-indigo-100 outline-none transition-all"
                        >
                        <datalist id="category-suggestions">
                            <option value="Beauty">
                            <option value="Groceries">
                            <option value="Electronics">
                            <option value="Clothing">
                            <option value="Footwear">
                        </datalist>
                    </div>

                    <div>
                        <label for="price" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">
                            Price (₹)
                        </label>
                        <div class="relative">
                            <span class="absolute left-3.5 top-2.5 text-slate-400 text-sm font-semibold">₹</span>
                            <input 
                                type="number" 
                                id="price"
                                name="price" 
                                required
                                min="0"
                                value="<%= product.price %>"
                                placeholder="199" 
                                class="w-full pl-8 pr-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:bg-white focus:border-indigo-500 focus:ring-4 focus:ring-indigo-100 outline-none transition-all"
                            >
                        </div>
                    </div>
                </div>

                <!-- Submit Button -->
                <div class="pt-4">
                    <button 
                        type="submit" 
                        class="w-full py-3 px-6 text-sm font-semibold text-white bg-indigo-600 hover:bg-indigo-700 active:scale-[0.99] rounded-xl shadow-md shadow-indigo-100 transition-all flex items-center justify-center gap-2">
                        <span>💾</span> Save Changes
                    </button>
                </div>

            </form>
        </div>
    </div>

</body>
</html>