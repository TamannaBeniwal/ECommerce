<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Checkout | E-Shop</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Font Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
        }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 antialiased min-h-screen py-10 px-4 sm:px-6 lg:px-8">

    <div class="max-w-xl mx-auto">
        <!-- Back Navigation -->
        <div class="mb-6">
            <a href="/cart" class="inline-flex items-center gap-2 text-xs font-semibold text-slate-500 hover:text-slate-900 transition">
                <span>←</span> Back to Cart
            </a>
        </div>

        <!-- Checkout Card Container -->
        <div class="bg-white rounded-3xl border border-slate-200 p-8 sm:p-10 shadow-sm">
            <div class="mb-8">
                <span class="text-xs font-bold uppercase tracking-wider text-emerald-600 bg-emerald-50 px-3 py-1 rounded-full">
                    Secure Checkout 🔒
                </span>
                <h1 class="text-2xl font-extrabold text-slate-900 tracking-tight mt-3">
                    Shipping & Payment
                </h1>
                <p class="text-xs text-slate-500 mt-1">
                    Enter your delivery address and choose a preferred payment mode.
                </p>
            </div>

            <form action="/cart/place-order" method="POST" class="space-y-5">
                
                <!-- Full Name -->
                <div>
                    <label for="name" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">
                        Recipient Name
                    </label>
                    <input 
                        type="text" 
                        id="name"
                        name="name" 
                        required 
                        placeholder="e.g. John Doe"
                        class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:bg-white focus:border-indigo-500 focus:ring-4 focus:ring-indigo-100 outline-none transition-all"
                    >
                </div>

                <!-- Shipping Address -->
                <div>
                    <label for="address" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">
                        Delivery Address
                    </label>
                    <textarea 
                        id="address"
                        name="address" 
                        rows="2"
                        required 
                        placeholder="House no., Street, Area, City, Pincode"
                        class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:bg-white focus:border-indigo-500 focus:ring-4 focus:ring-indigo-100 outline-none transition-all resize-none"
                    ></textarea>
                </div>

                <!-- Phone Number -->
                <div>
                    <label for="phone" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">
                        Contact Phone
                    </label>
                    <input 
                        type="tel" 
                        id="phone"
                        name="phone" 
                        required 
                        placeholder="+91 98765 43210"
                        class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:bg-white focus:border-indigo-500 focus:ring-4 focus:ring-indigo-100 outline-none transition-all"
                    >
                </div>

                <!-- Payment Method -->
                <div>
                    <label for="payment" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">
                        Payment Method
                    </label>
                    <select 
                        id="payment"
                        name="payment"
                        class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:bg-white focus:border-indigo-500 focus:ring-4 focus:ring-indigo-100 outline-none transition-all cursor-pointer"
                    >
                        <option value="cod">💵 Cash on Delivery (COD)</option>
                        <option value="card">💳 Credit / Debit Card (Online)</option>
                    </select>
                </div>

                <!-- Submit Button -->
                <div class="pt-4">
                    <button 
                        type="submit" 
                        class="w-full py-3.5 px-6 text-sm font-semibold text-white bg-indigo-600 hover:bg-indigo-700 active:scale-[0.99] rounded-xl shadow-md shadow-indigo-100 transition-all flex items-center justify-center gap-2">
                        <span>🛍️</span> Confirm & Place Order
                    </button>
                </div>

            </form>
        </div>
    </div>

</body>
</html>